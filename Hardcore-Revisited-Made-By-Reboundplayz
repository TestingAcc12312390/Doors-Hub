-- Room Conversion Logic with fully fortified validation
local function Convert(Room)
    if not Room or not Room:IsA("Instance") or not Room.Parent then return end
    
    local success, roomNum = pcall(function()
        return tonumber(Room.Name:match("%d+"))
    end)
    
    if success and roomNum and roomNum >= 51 then
        task.wait(1)
        if not Room or not Room.Parent then return end
        
        for _, asset in ipairs(Room:GetDescendants()) do
            if asset and asset.Parent and asset.Name == "Neon" then
                local parent = asset.Parent
                if parent then
                    for _, v in ipairs(parent:GetDescendants()) do
                        if v and (v:IsA("PointLight") or v:IsA("SpotLight")) then
                            pcall(function() v:Destroy() end)
                        end
                    end
                end
                pcall(function() asset:Destroy() end)
            end
        end
    end
end

currentRooms.ChildAdded:Connect(Convert)

for _, room in ipairs(currentRooms:GetChildren()) do
    Convert(room)
end
