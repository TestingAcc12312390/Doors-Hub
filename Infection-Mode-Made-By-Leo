local IMAGES = {
	"rbxassetid://84426996855215",
	"rbxassetid://100747358889360",
	"rbxassetid://119322997498243",
	"rbxassetid://136626205066563",
	"rbxassetid://137901103376590",
	"rbxassetid://131758820624433",
	"rbxassetid://116805943311693",
	"rbxassetid://74179368824762"
}

local current = 1
local edited = {}

local function GetNextImage()

	local img = IMAGES[current]

	current += 1

	if current > #IMAGES then
		current = 1
	end

	return img
end

local function IsPainting(name)

	name = name:lower()

	return name:find("paint")
	or name:find("frame")
	or name:find("canvas")
	or name:find("art")
end

local function EditObject(v)

	if edited[v] then
		return
	end

	if v:IsA("Decal") then

		local p = v.Parent

		if p and IsPainting(p.Name) then

			edited[v] = true
			v.Texture = GetNextImage()
		end
	end

	if v:IsA("ImageLabel") then

		local p = v.Parent and v.Parent.Parent

		if p and IsPainting(p.Name) then

			edited[v] = true
			v.Image = GetNextImage()
		end
	end
end

for _,v in ipairs(Workspace:GetDescendants()) do

	pcall(function()

		EditObject(v)

	end)
end

Workspace.DescendantAdded:Connect(function(v)

	pcall(function()

		EditObject(v)

	end)
end)

