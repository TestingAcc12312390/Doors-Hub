local changed = {}

local function CheckSound(v)

	if changed[v] then
		return
	end

	if v:IsA("Sound") then

		local n = v.Name:lower()
		local p = v.Parent and v.Parent.Name:lower() or ""

		if n:find("seek")
		or n:find("chase")
		or p:find("seek")
		or p:find("chase") then

			changed[v] = true

			v.SoundId = NEW_SEEK_MUSIC
			v.Volume = 1

			if v.IsPlaying then

				v:Stop()
				task.wait()
				v:Play()
			end
		end
	end
end

