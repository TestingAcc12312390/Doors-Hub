-- ===== Queue system (Ð¿Ñ€ÐµÐ´Ð¾Ñ‚Ð²Ñ€Ð°Ñ‰Ð°ÐµÑ‚ Ð¾Ð´Ð½Ð¾Ð²Ñ€ÐµÐ¼ÐµÐ½Ð½Ð¾Ðµ Ð¿Ð¾ÑÐ²Ð»ÐµÐ½Ð¸Ðµ) =====
local entityQueue = {}
local isProcessing = false

local function processQueue()
    if isProcessing or #entityQueue == 0 then return end
    isProcessing = true
    local nextEntity = table.remove(entityQueue, 1)
    local spawnFunc = nextEntity.func
    local spawnDelay = nextEntity.delay or 0
    task.wait(spawnDelay)
    spawnFunc()
    -- Ð¶Ð´Ñ‘Ð¼, Ð¿Ð¾ÐºÐ° ÑÑƒÑ‰Ð½Ð¾ÑÑ‚ÑŒ Ð½Ðµ Ð·Ð°Ð²ÐµÑ€ÑˆÐ¸Ñ‚ÑÑ (Ð¿Ñ€Ð¸Ð±Ð»Ð¸Ð·Ð¸Ñ‚ÐµÐ»ÑŒÐ½Ð¾)
    task.wait(2) -- Ð½ÐµÐ±Ð¾Ð»ÑŒÑˆÐ°Ñ Ð¿Ð°ÑƒÐ·Ð° Ð¼ÐµÐ¶Ð´Ñƒ ÑÑƒÑ‰Ð½Ð¾ÑÑ‚ÑÐ¼Ð¸
    isProcessing = false
    processQueue()
end

local function addToQueue(func, delay)
    table.insert(entityQueue, {func = func, delay = delay or 0})
    processQueue()
end

-- ===== Room list generation =====
local function generateRooms(start, finish, step, seedOffset, minAdd, maxAdd)
    local list = {}
    for i = start, finish, Random.new(seed):NextInteger(step-2, step+2) do
        table.insert(list, Random.new(seed + i):NextInteger(i + minAdd, i + maxAdd))
    end
    return list
end

