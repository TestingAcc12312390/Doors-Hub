-- Helper function to load scripts asynchronously and safely
local function loadScriptAsync(url, name)
    task.spawn(function()
        local success, source = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success and source and not source:find("404: Not Found") then
            local func, err = loadstring(source)
            if func then
                local runSuccess, runErr = pcall(func)
                if not runSuccess then
                    warn("ðŸ”´ Error running script [" .. name .. "]: " .. tostring(runErr))
                end
            else
                warn("âŒ Syntax error in [" .. name .. "]: " .. tostring(err))
            end
        else
            warn("âš ï¸ Failed to download [" .. name .. "] (URL broken, offline, or timed out)")
        end
    end)
end

